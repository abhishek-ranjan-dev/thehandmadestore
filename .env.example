# Shiprocket API credentials (create a dedicated API user in the Shiprocket
# dashboard: Settings → API → Configure — do NOT use your main login).
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Without these set, the delivery routes hard-fail with 502 by design.

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Optional — the store's pickup origin. Defaults are used if omitted.
# SHIPROCKET_PICKUP_LOCATION must exactly match a pickup location configured in
# the Shiprocket dashboard.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=110030
